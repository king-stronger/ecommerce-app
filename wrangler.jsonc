{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ecommerce-app",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// SSR reaches the API through a service binding (workers.dev -> workers.dev
	// over the public URL is blocked by Cloudflare).
	"services": [{ "binding": "API", "service": "ecommerce-api" }],
	"workers_dev": true,
	"preview_urls": true
}
